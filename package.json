    "jszip": "3.10.2",
    "pdfkit": "^0.20.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "10.6.1",
    "esbuild": "^0.28.0",
    "firebase-admin": "13.10.0",
    "firebase-tools": "15.34.1",
    "postcss": "8.5.31",
    "tailwindcss": "3.4.19",
